# Dipra Soluciones Integrales - Apache configuration
# See MIGRATION_NOTES.md for the full rationale behind these rules.

# Prevent directory listings on any folder that has no index file.
Options -Indexes

# Custom error page instead of the host's generic 404.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS AND the canonical www host in a single redirect (avoids a
  #    double-hop for an http:// + non-www request). If this site is ever
  #    moved to a different domain, update the host references below.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^dipra-soluciones\.com$ [NC]
  RewriteRule ^ https://www.dipra-soluciones.com%{REQUEST_URI} [L,R=301]

  # 2. Optional clean URLs: allow /servicios as an alternative to
  #    /servicios.html without changing any of the site's existing links
  #    (which keep their .html extension in every internal href).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^.]+)$ $1.html [L]

  # 3. Legacy Webflow paths: this export's pages already use the same
  #    filenames the live Webflow site used, so there are no known old
  #    Webflow-only URLs to redirect from. If the previous Webflow site
  #    published different slugs, add 301s here, for example:
  #    RewriteRule ^old-slug/?$ /new-slug.html [L,R=301]
</IfModule>

# Browser caching for static assets. Conservative lifetimes: images/fonts/
# video rarely change and are safe to cache long; HTML is revalidated often
# so it gets a short lifetime instead of "no-cache" (still safe to update
# content at any time - browsers just re-check sooner).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>

# Compression for text-based assets (images/fonts/video are already
# compressed formats and are skipped).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/xml text/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Security headers that are safe for a static brochure site: none of these
# restrict where scripts/styles/fonts/video can load from, so they won't
# block the site's own assets or the one remaining third-party CDN
# reference documented in MIGRATION_NOTES.md.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Prevent .htaccess/.git/etc. from ever being served if accidentally uploaded.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
